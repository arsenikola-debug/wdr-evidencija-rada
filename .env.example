# WDR web — copy to .env.local

# mock  = in-memory adapter implementing the identical WdrApi interface (no backend)
# supabase = real project
# Za PRAVI projekat: supabase. Mock je samo za lokalni razvoj bez baze.
VITE_WDR_API=mock

VITE_SUPABASE_URL=https://<PROJECT-REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# PostgREST schema that exposes the RPC endpoints. Must stay `api`.
VITE_WDR_API_SCHEMA=api

# Mock only: which seeded role the mock session represents (operator | finance).
# `finance` opens the /finansije screens without a database.
VITE_WDR_MOCK_ROLE=operator

# Mock only: set to `demo` to see a fully priced calculation. Clearly marked in
# the UI; these are NOT seed data and never leave the mock adapter.
VITE_WDR_MOCK_RATES=

# `admin` otvara ekran Administracije bez baze (mock).

# -----------------------------------------------------------------------------
# NIKADA ovde: `service_role` ključ, lozinka baze, JWT tajna. Sve sa `VITE_`
# prefiksom završi u pretraživačkom paketu i vidljivo je svakome.
# -----------------------------------------------------------------------------
